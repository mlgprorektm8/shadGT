+VkDeviceSize VmaBlockVector::TrimEmptyBlocks()
+{
+    VkDeviceSize freed = 0;
+    for (;;)
+    {
+        VmaDeviceMemoryBlock* drop = VMA_NULL;
+        {
+            VmaMutexLockWrite lock(m_Mutex, m_hAllocator->m_UseMutex);
+            if (m_Blocks.size() <= m_MinBlockCount) break;
+            for (size_t i = m_Blocks.size(); i--; )
+            {
+                if (m_Blocks[i]->m_pMetadata->IsEmpty())
+                {
+                    drop = m_Blocks[i];
+                    freed += drop->m_pMetadata->GetSize();
+                    Remove(drop);
+                    break;
+                }
+            }
+        }
+        if (drop == VMA_NULL) break;
+        // Match Free(): destruction outside the vector lock.
+        drop->Destroy(m_hAllocator);
+        vma_delete(m_hAllocator, drop);
+    }
+    return freed;
+}
